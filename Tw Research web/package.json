{
  "name": "autopredator-monorepo",
  "version": "1.0.0",
  "description": "Autopredator monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "node scripts/bootstrap.js",
    "dev": "node scripts/dev.js",
    "check": "node scripts/check.js",
    "api:dev": "npm run dev --workspace=apps/api",
    "api:test": "npm run test --workspace=apps/api",
    "api:lint": "npm run lint --workspace=apps/api",
    "api:format": "npm run format --workspace=apps/api",
    "api:typecheck": "npm run typecheck --workspace=apps/api",
    "web:dev": "npm run dev --workspace=apps/web",
    "web:build": "npm run build --workspace=apps/web",
    "web:test": "npm run test --workspace=apps/web",
    "web:lint": "npm run lint --workspace=apps/web",
    "web:format": "npm run format --workspace=apps/web",
    "web:typecheck": "npm run typecheck --workspace=apps/web"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  }
}
