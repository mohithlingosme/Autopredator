{
  "info": {
    "name": "Autopredator API",
    "_postman_id": "9a5a07b4-1234-4b6a-bbfc-0d80a1ab7a0d",
    "description": "Sample collection for API explorers",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Obtain tokens",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"demo\", \"password\": \"Secret123\"}"
        },
        "url": {
          "raw": "{{apiUrl}}/auth/token/",
          "host": ["{{apiUrl}}"],
          "path": ["auth", "token", ""]
        }
      }
    },
    {
      "name": "List vehicles",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "url": {
          "raw": "{{apiUrl}}/vehicles/",
          "host": ["{{apiUrl}}"],
          "path": ["vehicles", ""]
        }
      }
    },
    {
      "name": "Fleet analytics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "url": {
          "raw": "{{apiUrl}}/analytics/cost/",
          "host": ["{{apiUrl}}"],
          "path": ["analytics", "cost", ""]
        }
      }
    },
    {
      "name": "Predict service",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"vehicle_id\": 1, \"mileage\": 42000, \"vehicle_type\": \"truck\", \"last_service_days\": 45}"
        },
        "url": {
          "raw": "{{apiUrl}}/predict/",
          "host": ["{{apiUrl}}"],
          "path": ["predict", ""]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "apiUrl",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "jwt",
      "value": ""
    }
  ]
}
