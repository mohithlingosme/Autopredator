# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Python
*.py text eol=lf
*.pyc binary
*.pyo binary
*.pyd binary

# JavaScript/TypeScript
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# JSON
*.json text eol=lf

# YAML
*.yml text eol=lf
*.yaml text eol=lf

# Markdown
*.md text eol=lf

# Shell scripts
*.sh text eol=lf executable
*.bash text eol=lf executable

# Docker
Dockerfile* text eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.7z binary

# Database
*.db binary
*.sqlite binary
*.sqlite3 binary

# Logs
*.log text eol=lf

# Environment files
.env* text eol=lf -diff
.env.* text eol=lf -diff

# Secrets
secrets.* text eol=lf -diff
